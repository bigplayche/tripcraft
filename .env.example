# TripCraft environment. Copy to .env.local. With nothing set, the app runs in DEMO MODE:
# embedded Postgres in ./.data, local email/password sign-in, sample planner, OpenStreetMap.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (auth, Postgres, private storage). Set all three to leave demo mode. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Postgres connection string (Supabase > Connect > Transaction pooler). Server only.
DATABASE_URL=
DATABASE_POOL_MAX=5

# --- OpenAI (itineraries, concierge, discovery, budget advice). Server only. ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional, reasoning models only: low | medium | high
OPENAI_REASONING_EFFORT=
# Optional: USD per 1M tokens for your model, used for cost monitoring in ai_usage
AI_PRICE_INPUT_PER_MTOK=0.25
AI_PRICE_OUTPUT_PER_MTOK=2

# --- Google Maps Platform ---
# Server key: Places API (New) + Routes API. Restrict by API, never expose to the browser.
GOOGLE_MAPS_API_KEY=
# Browser key: Maps JavaScript API only, restricted by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=

# --- Development fallbacks (no keys needed) ---
# OSRM routing fallback when Google Routes is not configured. Set to "off" to disable.
OSRM_URL=https://router.project-osrm.org
# Open-Meteo forecasts. Set to "off" to disable.
WEATHER_PROVIDER=open-meteo

# --- Stripe (subscriptions). Server only. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_TRIP_PASS=

# While Stripe is NOT configured, give every user this plan for free: plus | pro. Leave empty for the Free plan.
FREE_ACCESS_PLAN=

# --- Demo mode only ---
# Signs the local session cookie. Auto-generated into ./.data if unset.
SESSION_SECRET=
